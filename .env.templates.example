# Copy only needed values into .env.local / your deployment secret store.
# Local administrator authentication; Prisma connects to MySQL 8.0.16+.
# Preferred: a percent-encoded MySQL URL. When nonempty, it overrides TEMPLATE_MYSQL_*.
# DATABASE_URL="mysql://user:encoded-password@host:3306/timeprint_share_wm?connection_limit=10&sslaccept=strict"
# For private CAs also set sslcert to an absolute certificate path in the URL.
DATABASE_URL=

# Legacy split configuration remains supported when DATABASE_URL is empty.
TEMPLATE_MYSQL_HOST=127.0.0.1
TEMPLATE_MYSQL_PORT=3306
TEMPLATE_MYSQL_DATABASE=timeprint_share_wm
TEMPLATE_MYSQL_USER=timeprint_service
TEMPLATE_MYSQL_PASSWORD=
TEMPLATE_MYSQL_SSL=true

# Tencent COS; credentials stay on the server. New objects use a dedicated directory.
TEMPLATE_COS_BUCKET=wm-1330977225
TEMPLATE_COS_REGION=ap-singapore
TEMPLATE_COS_PREFIX=template-assets-v2
TEMPLATE_COS_SECRET_ID=
TEMPLATE_COS_SECRET_KEY=
TEMPLATE_ACTOR_HMAC_KEY=
TEMPLATE_CURSOR_SIGNING_KEY=
TEMPLATE_API_ORIGIN=https://wm.timeprint.net
TEMPLATE_SHARE_ORIGIN=https://share.timeprint.net
TEMPLATE_ADMIN_ORIGIN=https://wm.timeprint.net,https://team.timeprint.net
# Exact verified hostnames only, comma separated. Empty disables legacy COS input.
TEMPLATE_ALLOWED_LEGACY_ASSET_HOSTS=
# Set only if the reverse proxy strips/replaces this header (e.g. x-real-ip).
TEMPLATE_TRUSTED_IP_HEADER=

# Default closed until MySQL, Auth permissions and private storage are verified.
TEMPLATE_PUBLIC_ENABLED=false
TEMPLATE_PRIVATE_ENABLED=false
TEMPLATE_SEARCH_ENABLED=false
TEMPLATE_REPORT_ENABLED=false
